const DV_03 = [{"Mã": "DV37", "Tên việc": "Cắt tỉa cây hàng viền, hàng rào", "Nhóm thực hiện": "Nhà thầu", "Lịch": "Có lịch", "Tần suất": "1 lần/kỳ tháng (20 → 19)", "Áp dụng": "Danh sách hàng rào", "Ảnh": "Bắt buộc"}, {"Mã": "DV38", "Tên việc": "Bón phân cây thủy sinh", "Nhóm thực hiện": "Nhà thầu", "Lịch": "Có lịch", "Tần suất": "1 lần/kỳ tháng (20 → 19)", "Áp dụng": "Hồ thủy sinh Villa 1–24", "Ảnh": "Bắt buộc"}];
const LOI_03 = [["Thủy sinh", "Chăm sóc cây thủy sinh", "Trung bình"], ["Thủy sinh", "Hồ thủy sinh có rong, rêu", "Trung bình"]];
const BB_03 = [{"loai": "Bãi biển", "ma": "BB01", "ten": "Bãi cát Aura"}, {"loai": "Bãi biển", "ma": "BB02", "ten": "Bãi ghế tắm nắng và sân bóng chuyền"}, {"loai": "Bãi biển", "ma": "BB03", "ten": "Villa 01–06"}, {"loai": "Bãi biển", "ma": "BB04", "ten": "Villa 07–14"}];
const CN_DOI_03 = {"CN02": "Đội khu vực", "CN03": "Đội cơ động"};

function khoiTao03_(nen, log) {
  Object.keys(NEN_03).forEach(function (t) { if (taoTrangNeuThieu_(nen, t, NEN_03[t])) log.push('Thêm trang ' + t); });
  // cột mới ở danh mục
  themCot_(nen, 'DanhMucCay', 'Dịch hại thường gặp', function (r) { return CAY_DH_03[r['Mã']] || ''; }, log);
  themCot_(nen, 'ViTri', 'Có mái che', function () { return ''; }, log);
  // đầu việc DV37, DV38
  upsert_(nen, 'DauViec', DV_03, log);
  // lỗi thủy sinh
  const loi = nen.getSheetByName('LoiCanhQuan');
  if (loi) { const co = loi.getDataRange().getValues().map(function (r) { return String(r[1]); }); const them = LOI_03.filter(function (r) { return co.indexOf(r[1]) < 0; }); if (them.length) { loi.getRange(loi.getLastRow() + 1, 1, them.length, 3).setValues(them); log.push('Thêm ' + them.length + ' lỗi thủy sinh'); } }
  // điểm bãi biển
  upsert_(nen, 'DiemKhac', BB_03.map(function (x) { return { 'Loại': x.loai, 'Mã': x.ma, 'Tên': x.ten }; }), log);
  // đội của 2 tổ trưởng (chỉ điền khi đang trống)
  const cn = nen.getSheetByName('CongNhan');
  if (cn) { const v = cn.getDataRange().getValues(); const h = v[0].map(String); const cMa = h.indexOf('Mã'), cDoi = h.indexOf('Đội');
    if (cMa >= 0 && cDoi >= 0) for (let i = 1; i < v.length; i++) if (CN_DOI_03[v[i][cMa]] && !v[i][cDoi]) cn.getRange(i + 1, cDoi + 1).setValue(CN_DOI_03[v[i][cMa]]); }
}
function themCot_(ss, ten, cot, giaTri, log) {
  const sh = ss.getSheetByName(ten); if (!sh || sh.getLastRow() < 1) return;
  const v = sh.getDataRange().getValues(); const h = v[0].map(String); if (h.indexOf(cot) >= 0) return;
  const c = sh.getLastColumn() + 1; sh.getRange(1, c).setValue(cot).setFontWeight('bold');
  if (v.length > 1) sh.getRange(2, c, v.length - 1, 1).setValues(v.slice(1).map(function (r) { const o = {}; h.forEach(function (k, i) { o[k] = r[i]; }); return [giaTri(o)]; }));
  log.push(ten + ' + cột ' + cot);
}
function upsert_(ss, ten, rows, log) {
  const sh = ss.getSheetByName(ten); if (!sh) return;
  const v = sh.getDataRange().getValues(); const h = v[0].map(String); const cMa = h.indexOf('Mã'); if (cMa < 0) return;
  rows.forEach(function (o) {
    Object.keys(o).forEach(function (k) { if (h.indexOf(k) < 0) { h.push(k); sh.getRange(1, h.length).setValue(k).setFontWeight('bold'); } });
    const i = v.findIndex(function (r) { return r[cMa] === o['Mã']; });
    if (i > 0) Object.keys(o).forEach(function (k) { sh.getRange(i + 1, h.indexOf(k) + 1).setValue(o[k]); });
    else { sh.appendRow(h.map(function (k) { return o[k] !== undefined ? o[k] : ''; })); log.push(ten + ' + ' + o['Mã']); }
  });
}
